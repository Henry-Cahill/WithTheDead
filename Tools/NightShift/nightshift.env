# Night Shift settings. Read every time it starts, so no container restart is needed after editing.

# Model for the agents. A name like gpt-oss:120b is a model in the Spark's Ollama (qwen3.8 is the newest Qwen: 27B,
# ~22 tokens/s on the Spark; gpt-oss:120b is about twice as fast). opencode/<id> is one of OpenCode's own models, run in
# its cloud: opencode/big-pickle is Big Pickle, free for a limited time. OpenCode's free models answer only OpenCode,
# have an allowance OpenCode doesn't publish (third parties measure a few hundred requests a day per network; a task
# takes dozens, and OpenCode used on other machines here likely counts too), and may use the code they're sent to
# improve the model.
NIGHTSHIFT_MODEL=opencode/big-pickle

# Model for the helper machines' agents. Ollama serves qwen3.8 one request at a time (its architecture
# doesn't support parallel requests yet), so helpers using it would only queue behind the Spark's agent;
# gpt-oss:120b runs several requests at once. Leave empty to use NIGHTSHIFT_MODEL everywhere.
NIGHTSHIFT_HELPER_MODEL=

# Model the whole night shift (agents and planner) switches to, for the rest of the night, once one of OpenCode's own
# stops answering, as Big Pickle does when the free allowance runs out. The task in progress goes back in the queue
# and starts again on it. Empty: the workers on that model stop instead.
NIGHTSHIFT_FALLBACK_MODEL=gpt-oss:120b

# Don't start new tasks after this local time (24-hour clock, e.g. 07:00). Leave empty to keep working into the
# day until you stop it: the night-shift toggle in AI Workbench, or NightShift.ps1 stop / finish.
NIGHTSHIFT_STOP_AT=
NIGHTSHIFT_TZ=America/Chicago

# Give up on a task after this many minutes, fix rounds included.
NIGHTSHIFT_TASK_MINUTES=120

# Extra rounds to fix compile errors after the agent says it's done.
NIGHTSHIFT_FIX_ROUNDS=2

# Context window (tokens) the agent plans for on a model in Ollama. Ollama gives qwen3.8 256K, gpt-oss:120b 128K;
# OpenCode's own models come with theirs (Big Pickle: 200K).
NIGHTSHIFT_CONTEXT=131072

# How helper machines reach Ollama on the Spark (for a model there, the fallback included).
NIGHTSHIFT_HELPER_OLLAMA_URL=http://192.168.1.252:11434

# 0 = the Spark only coordinates and the helpers do all the tasks.
NIGHTSHIFT_LOCAL_WORKER=1

# 1 = stay on duty (until the stop time, if one is set), picking up tasks added to tasks.md in the meantime;
# 0 = stop as soon as the queue is empty.
NIGHTSHIFT_WAIT_FOR_TASKS=1

# 1 = the queue never runs dry: whenever fewer tasks are waiting than there are workers (plus two), the night shift
# writes the next one itself. It goes round the focus areas below, shows the local model one script at a time (the one
# shown least recently) and queues the task it writes under "### Auto-planned <date>" in tasks.md, once the task names
# that script, mentions only scripts that exist and repeats nothing already there. Delete any you don't want.
# 0 = only the tasks you write.
NIGHTSHIFT_AUTOPLAN=1

# The focus areas, taken in turn (list one twice to give it more turns): map (the real-world raid map's code, once it
# exists), graphics (detail on objects), fixes, perf (per-frame work), features, flavour (written text), docs (summaries
# for public members), explain (comments for code that has none: long methods with no comment inside, and methods and
# types with no comment above).
# A trailing "+" (map+, graphics+, fixes+, perf+, features+, flavour+) asks for one big task instead of a small one:
# three to six located steps ("Step 1:", "Step 2:"...) that may also reach into two related scripts and add a new one.
NIGHTSHIFT_AUTOPLAN_FOCUS=map+,graphics+,fixes+,graphics+,perf,features+,flavour+,docs,explain

# Workers on these models (comma-separated) take only small tasks: anything written in steps, or longer than eight
# detail lines, goes to the other workers, which take the planner's big tasks first. The planner keeps a small task
# waiting for each such worker (the next focus in turn, written small). qwen3.8 lands about three tasks in four, at
# half an hour each; gpt-oss:120b lands nearly all of them in minutes, so it gets the big ones. If no worker that takes
# big tasks is left, every worker takes any task. Empty: every worker takes any task.
NIGHTSHIFT_SMALL_TASK_MODELS=qwen3.8

# Workers (helper names as the log shows them, or their host; comma-separated) that work through the documentation
# queue and nothing else: the tasks of the docs and explain focuses, which add comments. While one is on duty the other
# workers leave those tasks to it, the planner keeps one waiting for each (docs and explain taking turns) and skips both
# in its rotation. laserengraver is a Windows PC (see "Windows helpers" in README.md). all: every worker, so the night
# shift writes comments and nothing else, and other tasks wait in tasks.md (laserengraver puts the others back on the
# focus areas above). Empty: every worker takes any task. Whoever takes it, a documentation task lands only the comment
# lines it adds. A documentation worker uses NIGHTSHIFT_HELPER_MODEL (empty: NIGHTSHIFT_MODEL), like the other helpers.
NIGHTSHIFT_DOCS_WORKERS=laserengraver

# Model that writes the tasks. Empty: NIGHTSHIFT_HELPER_MODEL (it runs beside the agents), else NIGHTSHIFT_MODEL.
NIGHTSHIFT_AUTOPLAN_MODEL=

# With auto-planning on the queue never empties, so the automatic pull request (NightShift.ps1 autopr) publishes what
# has landed every this many minutes instead of waiting for the agents to run out of work. 0 = only when they do.
NIGHTSHIFT_PUBLISH_EVERY=120
