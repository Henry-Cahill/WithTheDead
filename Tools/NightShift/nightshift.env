# Night Shift settings. Read every time it starts, so no container restart is needed after editing.

# Model in the Spark's Ollama. qwen3.8 is the newest Qwen (27B, ~22 tokens/s on the Spark);
# gpt-oss:120b is about twice as fast.
NIGHTSHIFT_MODEL=qwen3.8

# Don't start new tasks after this local time (24-hour clock).
NIGHTSHIFT_STOP_AT=07:00
NIGHTSHIFT_TZ=America/Chicago

# Give up on a task after this many minutes, fix rounds included.
NIGHTSHIFT_TASK_MINUTES=120

# Extra rounds to fix compile errors after the agent says it's done.
NIGHTSHIFT_FIX_ROUNDS=2

# Context window (tokens) the agent plans for. Ollama gives qwen3.8 256K, gpt-oss:120b 128K.
NIGHTSHIFT_CONTEXT=131072

# How helper machines reach Ollama on the Spark.
NIGHTSHIFT_HELPER_OLLAMA_URL=http://192.168.1.252:11434

# 0 = the Spark only coordinates and the helpers do all the tasks.
NIGHTSHIFT_LOCAL_WORKER=1
