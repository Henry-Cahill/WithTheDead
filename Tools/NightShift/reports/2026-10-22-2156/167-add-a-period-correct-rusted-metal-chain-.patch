+        private static Color GetChainColor(MapBuilding b, System.Random rng)
+        {
+            Color baseCol = GetMatColor(b, rng);
+            float h, s, v;
+            Color.RGBToHSV(baseCol, out h, out s, out v);
+            // shift hue toward orange‑red and lower saturation a bit.
+            h = Mathf.Lerp(h, 0.05f, 0.3f);
+            s = Mathf.Clamp01(s * 0.7f);
+            v = Mathf.Clamp01(v * 0.9f);
+            return Color.HSVToRGB(h, s, v);
+        }
+
+        // Builds a rust‑colored metal chain from start to end using short cylinder segments.
+        private static void BuildChain(Site site, Vector3 start, Vector3 end, Color rustCol)
+        {
+            // number of full segments needed
+            float totalDist = Vector3.Distance(start, end);
+            int segCount = Mathf.CeilToInt(totalDist / ChainSegLength);
+            Vector3 dir = (end - start).normalized;
+            Vector3 segDelta = dir * ChainSegLength;
+            // metal rust material
+            Surf metalMat = DecorPalette.Metal(rustCol);
+            // compute yaw angle (degrees) for segment orientation around Y axis
+            float yaw = Mathf.Atan2(dir.x, dir.z) * Mathf.Rad2Deg;
+            for (int i = 0; i < segCount; ++i)
+            {
+                // centre of this segment
+                Vector3 segCenter = start + segDelta * (i + 0.5f);
+                // cylinder size (radius, length, radius)
+                Vector3 size = new Vector3(ChainRadius * 2f, ChainSegLength, ChainRadius * 2f);
+                site.Town.Out.Solid(segCenter).Box(segCenter, size, yaw, metalMat);
+                site.Town.PropCollider(segCenter, size, yaw);
+            }            }
