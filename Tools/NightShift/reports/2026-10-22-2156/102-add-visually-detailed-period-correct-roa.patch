diff --git a/Assets/Scripts/World/Map/SignpostHelper.cs b/Assets/Scripts/World/Map/SignpostHelper.cs
new file mode 100644
index 00000000..54cb19e7
--- /dev/null
+++ b/Assets/Scripts/World/Map/SignpostHelper.cs
@@ -0,0 +1,43 @@
+using UnityEngine;
+
+namespace CloneZ
+{
+    // Builds a simple metal‑pole signpost with a wooden board and four rivet cubes.
+    internal static class SignpostHelper
+    {
+        private static readonly Color BoardColor = new Color(0.5f, 0.35f, 0.2f); // weathered brown wood
+        private static readonly Surf BoardSurf = DecorPalette.Matte(BoardColor);
+        private static readonly float PoleRadius = 0.05f; // metres
+        private static readonly float PoleHeight = 1.2f; // metres
+        private static readonly Vector3 BoardSize = new Vector3(0.6f, 0.4f, 0.02f); // width, height, depth
+        private static readonly float RivetSize = 0.02f; // metres
+        public static void PlaceSignpost(OutdoorBatches into, Vector2 pos, float yawDeg)
+        {
+            // Ground position on the road surface.
+            Vector3 ground = new Vector3(pos.x, KentuckyMap.StreetY, pos.y);
+            // Metal pole.
+            into.Solid(ground).Box(ground, new Vector3(PoleRadius, PoleHeight, PoleRadius), yawDeg, KentuckyMap.StreetLampMetal);
+            // Board centre – at top of pole, offset forward 0.3 m.
+            float rad = yawDeg * Mathf.Deg2Rad;
+            Vector3 forward = new Vector3(Mathf.Sin(rad), 0f, Mathf.Cos(rad));
+            Vector3 boardCenter = ground + new Vector3(0f, PoleHeight, 0f) + forward * 0.3f;
+            into.Solid(boardCenter).Box(boardCenter, BoardSize, yawDeg, BoardSurf);
+            // Four rivet cubes at board corners.
+            Vector3 half = new Vector3(BoardSize.x * 0.5f, BoardSize.y * 0.5f, BoardSize.z * 0.5f);
+            Vector3[] corners = new[]
+            {
+                new Vector3( half.x, half.y, 0f),
+                new Vector3(-half.x, half.y, 0f),
+                new Vector3( half.x,-half.y, 0f),
+                new Vector3(-half.x,-half.y, 0f)
+            };
+            foreach (var off in corners)
+            {
+                // Rotate corner offset by yaw, then translate to board centre.
+                Vector3 rotated = Quaternion.Euler(0f, yawDeg, 0f) * off;
+                Vector3 rivetPos = boardCenter + rotated;
+                into.Solid(rivetPos).Box(rivetPos, new Vector3(RivetSize, RivetSize, RivetSize), yawDeg, KentuckyMap.StreetLampMetal);
+            }
+        }
+    }
+}
