+    private static void PlaceTrashCan(OutdoorBatches into, KentuckyMap.Site site, Vector2 lampPos, float lampYaw)
+    {
+        // Offset the can to the right side of the pole (relative to road direction).
+        const float offset = 0.45f; // metres from lamp centre
+        var dir = new Vector3(Mathf.Sin(lampYaw * Mathf.Deg2Rad), 0f, Mathf.Cos(lampYaw * Mathf.Deg2Rad));
+        var canPos2D = lampPos + new Vector2(dir.x, dir.z) * offset;
+        // Avoid overlapping other props.
+        if (!site.Free(canPos2D, 0.2f)) return;
+        site.Take(canPos2D, 0.2f);
+        // Random height for visual variety (0.70‑0.90 m).
+        int seed = ((int)(canPos2D.x * 73856093)) ^ ((int)(canPos2D.y * 19349663));
+        var rng = new System.Random(seed);
+        float canHeight = 0.70f + (float)rng.NextDouble() * 0.20f;
+        // Body – thin cylinder.
+        var bodyCenter = To3(canPos2D, 0.02f + canHeight * 0.5f);
+        var bodyMesh = into.Solid(bodyCenter);
+        // Add deterministic yaw wobble.
+        float wobble = ((canPos2D.x + canPos2D.y) * 0.231f) % 3f - 1.5f; // -1.5° … +1.5°
+        var rot = Quaternion.Euler(0f, lampYaw + wobble, 0f);
+        bodyMesh.Cylinder(bodyCenter, 0.15f, canHeight, 12, TrashCanSurf, rot);
+        // Lid – a flat disc on top.
+        var lidCenter = To3(canPos2D, 0.02f + canHeight);
+        var lidMesh = into.Solid(lidCenter);
+        lidMesh.Box(lidCenter, new Vector3(0.30f, 0.02f, 0.30f), 0f, TrashCanSurf);
+        // Handle – small vertical box on the front.
+        var handleOffset = new Vector3(0f, canHeight * 0.5f, 0.16f);
+        var handleCenter = bodyCenter + handleOffset;
+        var handleMesh = into.Solid(handleCenter);
+        handleMesh.Box(handleCenter, new Vector3(0.04f, 0.04f, 0.02f), 0f, TrashCanSurf);
+    }
+
