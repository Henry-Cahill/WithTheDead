+        /// <summary>
+        /// Adds a simple wooden porch step and rail to residential buildings, aligned to the north side,
+        /// with a thin snow overlay. Mirrors the hand‑built raid‑town look.
+        /// </summary>
+        private static void BuildPorch(Footprint f, Site site)
+        {
+            // Only apply to residential footprints
+            string use = f.Data.use ?? "";
+            bool isResidential = use.Contains("residential") ||
+                                 f.Data.kind == "house" || f.Data.kind == "trailer" ||
+                                 f.Data.kind == "apartments" || f.Data.kind == "hotel";
+            if (!isResidential) return;
+
+            // North edge centre (max Y bound)
+            float north = f.Bounds.yMax;
+            float centreX = (f.Bounds.xMin + f.Bounds.xMax) * 0.5f;
+            float centreZ = north + PorchTreadDepth * 0.5f; // step sits just outside the wall
+
+            // Ground‑level step box (collidable) – spans full width of the footprint
+            Vector3 stepCenter = new Vector3(centreX, PorchStepHeight * 0.5f, centreZ);
+            Vector3 stepSize = new Vector3(f.Bounds.width, PorchStepHeight, PorchTreadDepth);
+            site.Town.Out.Box(stepCenter, stepSize, DecorMaterials.Wood);
+
+            // Simple rail on the front edge of the step
+            Vector3 railCenter = new Vector3(centreX, PorchStepHeight + PorchRailHeight * 0.5f, centreZ - PorchTreadDepth * 0.5f);
+            Vector3 railSize = new Vector3(f.Bounds.width, PorchRailHeight, PorchRailWidth);
+            site.Town.Out.Box(railCenter, railSize, DecorMaterials.Wood);
+
+            // Thin snow overlay so the porch looks correctly snow‑covered
+            site.Overhead.At(f.Middle).Box(
+                new Vector3(centreX, StreetY + 0.01f + SnowDepth * 0.5f, centreZ),
+                new Vector3(stepSize.x, SnowDepth, stepSize.z),
+                DecorMaterials.Snow);
+
+            // Mark the area as taken so other props stay clear
+            site.Take(new Rect(f.Bounds.xMin, north, f.Bounds.width, PorchTreadDepth));
         }
 
 
