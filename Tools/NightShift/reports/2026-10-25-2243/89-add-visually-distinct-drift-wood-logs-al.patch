+                /// <summary>Scatter drift‑wood logs along a shore chain (rim or shelf).</summary>
+        private static void LogChain(Ground g, List<Vector2> chain, List<Vector2> normals, OutdoorBatches into)
+        {
+            int n = chain.Count;
+            for (int i = 0; i < n; i++)
+            {
+                // one log per ~3 m of shoreline, but skip very short segments
+                if (i > 0 && Vector2.Distance(chain[i - 1], chain[i]) < 0.5f) continue;
+                long key = MapStyle.Key(g.World(chain[i]));
+                // probability controlled by a per‑point random; only a few logs per lake/river
+                if (MapStyle.Unit(key, SaltDriftwood) > 0.3f) continue;
+                System.Random rng = MapStyle.Rng(key, SaltDriftwood + 1);
+                // place the log a little inside the water (negative normal) so it sits on the ice surface
+                Vector2 at = chain[i] - normals[i] * MapStyle.Range(rng, 0.05f, 0.15f);
+                if (!g.Clear(at, 0.2f)) continue; // avoid intersecting other props
+                AddDriftwoodLog(g, into, at, normals[i], rng);
+            }
+        }
+
+                /// <summary>Place a thin drift‑wood log on the ice at world‑space <paramref name="at"/>.</summary>
+        private static void AddDriftwoodLog(Ground g, OutdoorBatches into, Vector2 at, Vector2 normal, System.Random rng)
+        {
+            // orient the log roughly along the shoreline; a small random yaw adds variety
+            float yaw = Mathf.Atan2(normal.y, normal.x) + Mathf.PI * 0.5f + MapStyle.Range(rng, -0.2f, 0.2f);
+            float length = MapStyle.Range(rng, 0.6f, 1.2f); // metres
+            float thickness = 0.04f;
+            float height = 0.05f;
+            // centre of the log in world XYZ (use DecalY – the same height used for the rim/shelf geometry)
+            Vector3 c = To3(at, DecalY);
+            // build a rotation quaternion around Y
+            Quaternion rot = Quaternion.AngleAxis(yaw * Mathf.Rad2Deg, Vector3.up);
+            // four corner points of the log’s base (local XZ plane)
+            Vector3 half = new Vector3(length * 0.5f, 0f, thickness * 0.5f);
+            Vector3[] basePts = new[]
+            {
+                rot * new Vector3(-half.x, 0f, -half.z),
+                rot * new Vector3( half.x, 0f, -half.z),
+                rot * new Vector3( half.x, 0f,  half.z),
+                rot * new Vector3(-half.x, 0f,  half.z)
+            };
+            // raise the base to world centre
+            for (int i = 0; i < 4; i++) basePts[i] += c;
+            // top points
+            Vector3[] topPts = new Vector3[4];
+            for (int i = 0; i < 4; i++) topPts[i] = basePts[i] + Vector3.up * height;
+            // material – a weather‑worn brown
+            var logMat = DecorPalette.Matte(new Color(0.45f, 0.33f, 0.22f));
+            // build a simple box (12 triangles)
+            RaidMesh m = into.Solid(c);
+            // top
+            m.Tri(topPts[0], topPts[1], topPts[2], logMat);
+            m.Tri(topPts[0], topPts[2], topPts[3], logMat);
+            // sides
+            for (int i = 0; i < 4; i++)
+            {
+                int j = (i + 1) & 3;
+                m.Tri(basePts[i], basePts[j], topPts[j], logMat);
+                m.Tri(basePts[i], topPts[j], topPts[i], logMat);
+            }
+            // optional collider – tiny box centred on the log
+                if (g.Site.Take(at, 0.12f)) // reserves a little space; Take returns true if free
+                {
+                    g.Site.Town.PropCollider(c, new Vector3(length, height, thickness), yaw * Mathf.Rad2Deg);
+                }
         }
 
