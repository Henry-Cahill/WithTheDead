+                if (!g.Clear(base2D, 0.15f)) continue; // avoid overlapping other props
+                Vector3 base3 = To3(base2D, DecalY);
+                // ----- stone (low pyramid, 0.07 m tall, 0.04 m base) -----
+                if (rng.NextDouble() < 0.45)
+                {
+                    float r = 0.04f, h = 0.07f;
+                    Vector3 b0 = base3 + new Vector3(-r, 0f, -r);
+                    Vector3 b1 = base3 + new Vector3( r, 0f, -r);
+                    Vector3 b2 = base3 + new Vector3( r, 0f, r);
+                    Vector3 b3 = base3 + new Vector3(-r, 0f, r);
+                    Vector3 tip = base3 + Vector3.up * h;
+                    var stoneMat = DecorPalette.Matte(new Color(0.32f, 0.30f, 0.28f));
+                    RaidMesh m = into.Solid(base3);
+                    m.Tri(b0, b1, tip, stoneMat);
+                    m.Tri(b1, b2, tip, stoneMat);
+                    m.Tri(b2, b3, tip, stoneMat);
+                    m.Tri(b3, b0, tip, stoneMat);
+                }
+                // ----- mud puddle (flat disc, radius 0.15 m, depth 0.02 m) -----
+                if (rng.NextDouble() < 0.55)
+                {
+                    float r = 0.15f, h = 0.02f;
+                    Vector3 c = base3 + new Vector3(0f, h, 0f);
+                    Vector3 p0 = c + new Vector3(-r, 0f, -r);
+                    Vector3 p1 = c + new Vector3( r, 0f, -r);
+                    Vector3 p2 = c + new Vector3( r, 0f, r);
+                    Vector3 p3 = c + new Vector3(-r, 0f, r);
+                    var mudMat = DecorPalette.Matte(new Color(0.45f, 0.38f, 0.30f));
+                    RaidMesh m = into.Solid(c);
+                    m.Tri(p0, p1, p2, mudMat);
+                    m.Tri(p0, p2, p3, mudMat);
+                }
+                // ----- leaf litter (thin quad, 0.20 m × 0.12 m, 0.01 m above ground) -----
+                if (rng.NextDouble() < 0.4)
+                {
+                    float w = 0.20f, h = 0.12f;
+                    float angle = MapStyle.Range(rng, -20f, 20f) * Mathf.Deg2Rad;
+                    Vector3 right = new Vector3(Mathf.Cos(angle), 0f, Mathf.Sin(angle)) * (w/2);
+                    Vector3 forward = new Vector3(-Mathf.Sin(angle), 0f, Mathf.Cos(angle)) * (h/2);
+                    Vector3 leafC = base3 + new Vector3(0f, 0.01f, 0f);
+                    Vector3 l0 = leafC - right - forward;
