+/// <summary>
+/// Builds a flat canopy over a school's or an office's doors, now with timber support posts,
+/// a period‑correct wooden sign‑board, and optional snow caps.
+/// </summary>
+private static void EntranceCanopy(Job j)
+{
+    int e = j.DoorEdge;
+    float w = DoubleDoorWidth + 1.8f, depth = 1.9f, y = 2.75f;
+    Vector2 at = j.At(e, j.DoorAt) + j.Out[e] * (depth * 0.5f);
+    float yaw = j.Yaw(e);
+    Surf trim = DecorPalette.Matte(new Color(0.86f, 0.86f, 0.84f));
+    // canopy top
+    j.Upper.Box(To3(at, y), new Vector3(w, 0.2f, depth), yaw, trim);
+    // optional snow caps
+    if (j.P.Snow != SnowCover.Bare) j.Upper.Box(To3(at, y + 0.14f), new Vector3(w - 0.1f, 0.08f, depth - 0.1f), yaw, RoofSnow);
+    // support posts – round timber, 0.12 m radius, full height of the canopy
+    Surf postMat = DecorPalette.Matte(new Color(0.57f, 0.44f, 0.31f));
+    for (int s = -1; s <= 1; s += 2)
+    {
+        Vector2 postPos = at + j.Dir[e] * ((w * 0.5f - 0.25f) * s);
+        Vector3 postC = To3(postPos, y * 0.5f);
+        var postSize = new Vector3(0.12f, y, 0.12f);
+        j.Facing(e).Box(postC, postSize, yaw, postMat);
+        if (j.Solid) Collider(j, postC, postSize, yaw);
+        // mark space as used
+        j.Site.Take(postPos, 0.2f);
+    }
+    // wooden sign board – period‑correct hand‑painted title
+    float signY = y + 0.12f; // just above the canopy top
+    float signW = w * 0.6f;
+    float signH = 0.28f;
+    Vector2 signPos2D = at + j.Dir[e] * (w * 0.15f);
+    AddCanopySign(j, signPos2D, yaw, signW, signH, signY);
+}
