+        // draws a wooden pallet with optional metal corner straps and wear detail
+        private static void PalletWithStraps(RaidMesh m, System.Random r, Vector3 offset, bool loaded)
+        {
+            // base wood colour – same as the wooden bench palettes used elsewhere
+            Surf wood = DecorPalette.Matte(new Color(0.62f, 0.48f, 0.30f));
+            // metal colour for straps
+            Surf metal = DecorPalette.Matte(new Color(0.30f, 0.30f, 0.30f));
+            // three slats forming the pallet deck (size 1.2 m × 1.0 m, thickness 0.02 m)
+            // slat 1
+            m.Box(offset + new Vector3(-0.55f, 0.02f, -0.45f), new Vector3(0.04f, 0.02f, 0.9f), wood);
+            // slat 2
+            m.Box(offset + new Vector3(0f, 0.02f, -0.45f), new Vector3(0.04f, 0.02f, 0.9f), wood);
+            // slat 3
+            m.Box(offset + new Vector3(0.55f, 0.02f, -0.45f), new Vector3(0.04f, 0.02f, 0.9f), wood);
+            // optional side rails (only when the pallet is loaded, to hint at extra weight)
+            if (loaded)
+            {
+                // left rail
+                m.Box(offset + new Vector3(-0.55f, 0.14f, -0.45f), new Vector3(0.04f, 0.28f, 0.02f), wood);
+                // right rail
+                m.Box(offset + new Vector3(0.55f, 0.14f, -0.45f), new Vector3(0.04f, 0.28f, 0.02f), wood);
+    
+            // four metal corner straps – 0.06 m × 0.008 m × 0.008 m, positioned on top of the deck
+            float strapHeight = 0.06f + MapStyle.Range(r, -0.01f, 0.01f);
+            // front‑left
+            m.Box(offset + new Vector3(-0.55f, strapHeight, -0.45f), new Vector3(0.008f, 0.015f, 0.008f), metal);
+            // front‑right
+            m.Box(offset + new Vector3(0.55f, strapHeight, -0.45f), new Vector3(0.008f, 0.015f, 0.008f), metal);
+            // back‑left
+            m.Box(offset + new Vector3(-0.55f, strapHeight, 0.45f), new Vector3(0.008f, 0.015f, 0.008f), metal);
+            // back‑right
+            m.Box(offset + new Vector3(0.55f, strapHeight, 0.45f), new Vector3(0.008f, 0.015f, 0.008f), metal);
+            // occasional wear scratch: a thin dark box on a random slat (5 % chance)
+            if (r.NextDouble() < 0.05)
+            {
+                int s = r.Next(3);
+                float x = -0.55f + s * 0.55f;
+                Surf dark = DecorPalette.Matte(new Color(0.15f, 0.12f, 0.10f));
+                m.Box(offset + new Vector3(x, 0.025f, -0.2f + (float)r.NextDouble() * 0.4f),
+                      new Vector3(0.04f, 0.005f, 0.2f), dark);
+
+
