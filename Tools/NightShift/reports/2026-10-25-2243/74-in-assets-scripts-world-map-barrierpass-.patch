+        // Adds bolts, a wood brace and a wear stripe to a guard‑rail segment.
+        private static void AddGuardRailDetails(Ctx ctx, RaidMesh m, Vector2 a, Vector2 b, Vector2 d, float len, float yaw)
+        {
+            // 1️⃣ bolt spacing – 1.2 m, with a deterministic offset per segment.
+            float spacing = 1.2f;
+            // deterministic offset 0‑0.4 m using the segment’s start key
+            float offset = 0.4f * MapStyle.Unit(ctx.KeyOf(a), SaltStyle);
+            int boltCount = Mathf.FloorToInt((len - offset) / spacing) + 1;
+            for (int i = 0; i < boltCount; i++)
+            {
+                float t = offset + i * spacing;
+                if (t > len) break;
+                Vector2 pt = a + d * t;
+                // bolt – small Galvanised cylinder, centred at the top of the rail (≈0.78 m high)
+                m.Cylinder(To3(pt, 0.78f), 0.02f, 0.12f, 6, Galvanised);
+            }
+            // 2️⃣ wood brace – a short rectangular block at each post (the posts are already drawn by Posts()).
+            // Draw the brace only if the segment is longer than 0.5 m to avoid double‑drawing at tiny pieces.
+            if (len > 0.5f)
+            {
+                // brace sits halfway up the rail, 0.05 m thick, 0.12 m deep, 0.15 m wide.
+                float braceHeight = 0.55f; // metres above ground
+                float braceDepth = 0.12f;
+                float braceWidth = 0.15f;
+                // place the brace at the centre of the segment
+                Vector2 mid = (a + b) * 0.5f;
+                m.Box(To3(mid, braceHeight), new Vector3(braceWidth, braceDepth, braceDepth), yaw, Matte(FenceWood * 0.7f));
+            }
+            // 3️⃣ wear stripe – a thin dark box that runs the full length of the rail, 0.02 m high, 0.02 m thick.
+            // Gives the impression of rusted paint or accumulated grime.
+            Color wearCol = new Color(0.25f, 0.22f, 0.20f);
+            m.Box(To3((a + b) * 0.5f, 0.78f + 0.01f), new Vector3(len, 0.02f, 0.02f), yaw, Matte(wearCol));
+        }
