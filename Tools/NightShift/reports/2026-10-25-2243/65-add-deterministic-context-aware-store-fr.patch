+            /// <summary>Creates a short, upper‑case sign string for a commercial building.</summary>
+        /// <remarks>
+        /// If the building has a non‑empty Name, that name is used (trimmed to 12 characters) as the sign.
+        /// Otherwise a generic phrase based on the building's Use is chosen. The result is always upper‑case
+        /// and limited to characters that fit the existing sign band sprite set.
+        /// </remarks>
+        private static string GenerateSign(Plan p, System.Random rng)
+        {
+            // Prefer an explicit name – keep it short enough for the sign band texture.
+            if (!string.IsNullOrWhiteSpace(p.Name))
+            {
+                string clean = p.Name.Trim().ToUpperInvariant();
+                // Limit to 12 characters; longer names are truncated with a trailing "…" to hint omission.
+                return clean.Length <= 12 ? clean : clean.Substring(0, 11) + "…";
+            }
+            // No explicit name – fall back to a generic phrase based on the building use.
+            // The list mirrors the existing sign‑band vocab in the original game.
+            string[] generic = {
+                "GENERAL STORE", "MART", "DINER", "Café", "GAS STATION",
+                "PHARMACY", "BANK", "POST OFFICE", "BARBER", "REPAIR SHOP"
+            };
+            // Choose deterministically from the rng seeded per‑building.
+            return generic[rng.Next(generic.Length)].ToUpperInvariant();
+        }
         }
